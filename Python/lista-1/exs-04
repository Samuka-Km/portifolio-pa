# Descrição: Calcula a soma dos números pares de 1 até um número informado.

n1 = int(input("Digite um número positivo: "))
contador = 1 
soma = 0

if n1 > 0:
    while contador <= n1:
        if contador % 2 == 0:
            soma = soma + contador
        contador = contador + 1

    print("A soma dos números pares é:", soma)

else:
    print("Número inválido")
      
  
  


