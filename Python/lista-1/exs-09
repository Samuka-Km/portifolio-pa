# Descrição: Calcula o fatorial de um número inteiro positivo.

cont = 1
fatorial = 1
n1 = int(input("Digite um número positivo interio: "))

if n1 >= 0:
  while cont <= n1:
    fatorial = fatorial * cont
    cont += 1
  print(f"Fatorial: {fatorial}")

else:
  print("Número inválido.")
